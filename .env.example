# 首要配置文件
# 复制此文件为 .env 并修改配置后使用

# 项目的命名空间，如有更改，请更新docker-compose的yml文件，nginx的conf文件（可全项目搜索）
PROJECT_NAME=dcstarter

# docker 镜像仓库地址
DOCKER_REGISTRY=registry.cn-shenzhen.aliyuncs.com

# docker 容器IP段，同一台机器上的多个项目应设为不重复
IP_RANGE=192.168.225

# 系统级mysql 配置信息
SYS_MYSQL_HOST=mysql-sys
SYS_MYSQL_PORT=3306
# ⚠️ 安全警告: 请立即修改以下默认密码！
SYS_MYSQL_ROOT_PASSWORD=CHANGE_ME_NOW
SYS_MYSQL_DATABASE=classicmodels
SYS_MYSQL_USER=dcuser
# ⚠️ 安全警告: 请立即修改以下默认密码！
SYS_MYSQL_USER_PASSWORD=CHANGE_ME_NOW
CONNECT_SYS_MYSQL_AS_ROOT=true

# 应用级mysql 配置信息
APP_MYSQL_HOST=mysql-app
APP_MYSQL_PORT=3306
# ⚠️ 安全警告: 请立即修改以下默认密码！
APP_MYSQL_ROOT_PASSWORD=CHANGE_ME_NOW
APP_MYSQL_DATABASE=classicmodels
APP_MYSQL_USER=dcuser
# ⚠️ 安全警告: 请立即修改以下默认密码！
APP_MYSQL_USER_PASSWORD=CHANGE_ME_NOW
CONNECT_APP_MYSQL_AS_ROOT=true

# 系统级Redis配置信息
SYS_REDIS_HOST=redis-sys
SYS_REDIS_PORT=6379
# ⚠️ 安全警告: 请立即修改以下默认密码！
SYS_REDIS_PASSWORD=CHANGE_ME_NOW

# 应用级Redis配置信息
APP_REDIS_HOST=redis-app
APP_REDIS_PORT=6379
# ⚠️ 安全警告: 请立即修改以下默认密码！
APP_REDIS_PASSWORD=CHANGE_ME_NOW

# 系统级Admin帐号 配置
SYS_ADMIN_USERNAME=root
# ⚠️ 安全警告: 请立即修改以下默认密码！
SYS_ADMIN_PASSWORD=CHANGE_ME_NOW

# 应用级Admin帐号 配置
APP_ADMIN_USERNAME=root
# ⚠️ 安全警告: 请立即修改以下默认密码！
APP_ADMIN_PASSWORD=CHANGE_ME_NOW

# 备份 配置信息
DAYS_TO_KEEP_OLD_FILE=5
# 查看容器状态时，是否报告内存使用情况，是则耗时更长
REPORT_MEMORY_USAGE=false
# 全局TimeZone设置
TZ=Asia/Shanghai
# 启动时需要建立的外部网络名称，留空则不建立
GLOBAL_NETWORK=${PROJECT_NAME}_frontend_network
# 控制打印容器日志的条数，避免过长
LINE_OF_LOG=1000
